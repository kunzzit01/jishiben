# 部署环境变量（复制为 deploy/.env 后填写真实值；deploy/.env 不要提交）
# 由 deploy/docker-compose.yml 读取。

# ── 数据库（容器内部）──
DB_NAME=jishiben
DB_USER=jishiben
DB_PASSWORD=__CHANGE_ME_DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__CHANGE_ME_ROOT_PASSWORD__
MYSQL_MAX_CONNECTIONS=200

# ── API ──
# JWT 签名密钥：必须换成长随机串（>=32 字符），泄露等于所有人的登录态可伪造
JWT_SECRET=__CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS__
JWT_ISSUER=jishiben-api
JWT_ACCESS_TTL=PT24H
DB_POOL_MAX_SIZE=10
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL_APP=INFO

# ── 服务端 OCR 兜底（ocr 容器）──
# 客户端请求 /ocr/lines 时必须带同名请求头 X-OCR-Key，值与此处一致。
# 生成：openssl rand -hex 32
OCR_SHARED_KEY=__CHANGE_ME_OCR_SHARED_KEY__

# ── 对外端口（只有 nginx 发布）──
HTTP_PORT=80


# ── 订阅（正式环境）──
# 本文件对应正式 compose：BILLING_ENV 固定为 production，模拟订阅永远关闭。
# 模拟测试请用 docker-compose.staging.yml + .env.staging（独立数据库）。
# 管理员只认 Google 登录：首次用该 Gmail 经 Google 登录时固定其 Google 账号（sub）。
BILLING_ADMIN_EMAIL=
BILLING_ADMIN_GOOGLE_SUB=
# 打开前需完成 Play Console 商品、服务账号、Pub/Sub 推送，见 docs/SUBSCRIPTION-DEVELOPMENT.md
BILLING_GOOGLE_ENABLED=false
# 32 字节随机数的 Base64（openssl rand -base64 32），用于加密保存购买 token。必须备份；更换会使旧 token 无法解密。
BILLING_TOKEN_ENCRYPTION_KEY=
BILLING_PUSH_AUDIENCE=
BILLING_PUSH_EMAIL=
# 正式服务身份通过只读凭证挂载或受支持的 ADC 配置，见 docs/SUBSCRIPTION-DEVELOPMENT.md。
