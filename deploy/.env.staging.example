# staging（订阅模拟测试环境）配置模板。复制为 deploy/.env.staging 后填写，不提交 Git。
# 所有口令都必须与正式环境 deploy/.env 不同。

DB_NAME=jishiben_staging
DB_USER=jishiben_staging
DB_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME__

# 至少 32 字节，且不能与正式环境相同（两个环境的登录令牌互不通用）
JWT_SECRET=__CHANGE_ME_AT_LEAST_32_BYTES__

# 与正式相同的 Google 登录 Web Client ID（Google 登录是管理员身份的唯一来源）
GOOGLE_WEB_CLIENT_ID=

# 管理员：首次用该 Gmail 经 Google 登录时，服务器固定其 Google 账号（sub）。
# 也可直接填写 BILLING_ADMIN_GOOGLE_SUB 固定，填了以后邮箱不再起作用。
BILLING_ADMIN_EMAIL=
BILLING_ADMIN_GOOGLE_SUB=

STAGING_HTTP_PORT=8089

# ── 可选：在 staging 用许可证测试账号做真实 Google Play 测试 ──
BILLING_GOOGLE_ENABLED=false
# 32 字节随机数的 Base64（openssl rand -base64 32）；与正式环境不同
BILLING_TOKEN_ENCRYPTION_KEY=
BILLING_PUSH_AUDIENCE=
BILLING_PUSH_EMAIL=

# 只有 --profile ocr 启动 OCR 时需要
OCR_SHARED_KEY=
