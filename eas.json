{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://187.127.125.136",
        "ORG_GRADLE_PROJECT_openiapStore": "google"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://187.127.125.136",
        "ORG_GRADLE_PROJECT_openiapStore": "google"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://187.127.125.136/staging",
        "ORG_GRADLE_PROJECT_openiapStore": "google"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://187.127.125.136",
        "ORG_GRADLE_PROJECT_openiapStore": "google"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
