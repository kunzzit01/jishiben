# ─── 依赖安装包（本地保留，git 忽略；换机后 npm install 一键恢复） ───
node_modules/

# ─── Expo / React Native 构建产物与缓存 ───
.expo/
dist/
build/
web-build/
*.tsbuildinfo

# ─── 原生工程（npx expo prebuild 可重新生成，本地保留） ───
android/
ios/

# ─── 日志 ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── 密钥 / 环境变量（严禁入库） ───
.env
.env.*
!.env.example
*.keystore
*.jks

# ─── 本地备份与测试材料 ───
backup/
test-audio/

# ─── AI 工具工作目录（本地产物，不入库） ───
.agents/
.claude/
.zcode/
.mimosa/
Zcode/
prototype/
skills-lock.json

# ─── 编辑器 / 系统杂项 ───
.DS_Store
Thumbs.db
.idea/

# ─── 本地备份快照（不入库） ───
jizhang-app-backup-pre-*/

# ─── ZCode 工具配置（非 App 本体） ───
.zcodeignore

# ─── 临时工作目录（本地产物，不入库） ───
_scratch/
agent/

# 后端与部署（2026-10 加入 monorepo 布局）
server/target/
deploy/.env
deploy/backups/
.tools/
deploy/downloads/*.apk
deploy/downloads/*.aab
# 迁移/导入产生的 SQL（含真实账目）不进仓库
import*.sql
# 账号导入产物（含 bcrypt 哈希）不进仓库
users*.sql
auth-users.*
