# 前端（Expo Web 静态导出）+ nginx —— 单容器同时提供页面与 /api 反代
# 由 deploy/docker-compose.yml 的 web 服务调用：
#   context: ../_repo/jishiben   dockerfile: Dockerfile.web
#
# 要点：构建期把 API 基址设为同源（'/'），页面里的请求就是 /api/xxx，
# 由本容器 nginx 转给 api:8080 —— 不硬编码域名、不需要 CORS。

FROM node:20-alpine AS build
WORKDIR /app

# 依赖层：只有 package/lock 变了才重装
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
ENV EXPO_PUBLIC_API_BASE_URL=/
ENV EXPO_NO_TELEMETRY=1
RUN npx expo export --platform web --output-dir dist --clear

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html

# nginx 配置内联：不再依赖构建上下文之外的文件
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX'
upstream jishiben_api {
    server api:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 12m;
    server_tokens off;
    # 跳转一律用相对 Location：容器内 $scheme 是 http，绝对地址会拼出 http://，
    # 而 Android release 默认禁明文，客户端跟随这种跳转会直接失败。
    absolute_redirect off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass http://jishiben_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # 自建 OTA 更新服务（deploy/updates）：/updates、/updates/* → updates:8081
    # 用变量 + Docker 内置 DNS 让 nginx 在请求时解析上游：updates 容器比本容器晚起来，
    # 也不会让 nginx 因 "host not found in upstream" 起不来（静态 upstream 会在启动时解析）。
    # proxy_pass 不带 URI，转发的是原始请求路径（如 /updates/manifest），由 updates 自己剥前缀。
    #
    # 两个 location 都必要：expo-updates 客户端直接请求 updates.url 本身，
    # 即 GET /updates（不带尾斜杠）。而 nginx 对「以 / 结尾的前缀 location」在 URI 缺尾斜杠时
    # 会回 301 补斜杠（/api 同样如此），客户端跟随后即失败 —— 所以用精确匹配拦掉这个形状，
    # 保证 /updates 本身返回 manifest 而不是任何跳转。
    location = /updates {
        # OTA 产物（Hermes 字节码 .hbc）绝不能被 gzip：expo-updates 校验原始文件的 SHA-256，
        # 收到压缩流会哈希不匹配 → 下载被判失败、无限重试。
        # 2026-10-30 实测：带 gzip 只下 2,520,551 字节 / 实际 5,196,435 字节。
        gzip off;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $updates_upstream http://updates:8081;
        proxy_pass $updates_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    location /updates/ {
        # OTA 产物（Hermes 字节码 .hbc）绝不能被 gzip：expo-updates 校验原始文件的 SHA-256，
        # 收到压缩流会哈希不匹配 → 下载被判失败、无限重试。
        # 2026-10-30 实测：带 gzip 只下 2,520,551 字节 / 实际 5,196,435 字节。
        gzip off;
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $updates_upstream http://updates:8081;
        proxy_pass $updates_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 内测安装包：文件不存在就给 404，绝不回退到 index.html
    #（否则用户点 .apk 链接会看到 App 页面，误以为下载坏了）
    location /downloads/ {
        autoindex on;
        try_files $uri =404;
        default_type application/octet-stream;
        types {
            application/vnd.android.package-archive apk;
        }
        add_header Content-Disposition "attachment";
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}
NGINX

EXPOSE 80

# 容器级探活：命中 server 块里的 location = /healthz（不经 api）
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -q --spider http://127.0.0.1/healthz || exit 1
