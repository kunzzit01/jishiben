# 前端（Expo Web 静态导出）+ nginx —— 单容器同时提供页面与 /api 反代
# 由 deploy/docker-compose.yml 的 web 服务调用：
#   context: ../_repo/jishiben   dockerfile: Dockerfile.web
#
# 要点：构建期把 API 基址设为同源（'/'），页面里的请求就是 /api/xxx，
# 由本容器 nginx 转给 api:8080 —— 不硬编码域名、不需要 CORS。

FROM node:20-alpine AS build
WORKDIR /app

# 依赖层：只有 package/lock 变了才重装
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
ENV EXPO_PUBLIC_API_BASE_URL=/
ENV EXPO_NO_TELEMETRY=1
RUN npx expo export --platform web --output-dir dist --clear

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html

# nginx 配置内联：不再依赖构建上下文之外的文件
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX'
upstream jishiben_api {
    server api:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 12m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass http://jishiben_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
NGINX

EXPOSE 80
