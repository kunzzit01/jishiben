{
  "expo": {
    "name": "jizhang-app",
    "slug": "jizhang-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2FB",
      "dark": {
        "backgroundColor": "#06050C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kylim0103.jizhangapp",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.kylim0103.jizhangapp",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册，用来选择小票照片自动识别记账信息",
          "cameraPermission": "允许使用相机，用来拍摄小票照片自动识别记账信息"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许使用相机，用来拍摄小票照片自动识别记账信息"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-sharing",
      "expo-notifications",
      "expo-localization",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "3dba2e15-d71c-4ca6-af5d-04257ca3e073"
      }
    }
  }
}
